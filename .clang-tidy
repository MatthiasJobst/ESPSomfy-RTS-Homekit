---
# Only report diagnostics for project source files, not ESP-IDF or managed_components.
HeaderFilterRegex: '.*/SomfyController/main/.*'

CheckOptions:
  # int8_t (RSSI dBm, downloadFile error codes, etc.) is intentionally signed;
  # exclude it from bugprone-signed-char-misuse so we don't have to NOLINT every site.
  # NOTE: option name has a typo in clang-tidy 19.x — "Typdefs" not "Typedefs".
  # https://github.com/llvm/llvm-project — fixed upstream; revisit once we move to a newer toolchain.
  bugprone-signed-char-misuse.CharTypdefsToIgnore: 'int8_t'

# bugprone-easily-swappable-parameters is disabled for now: it has many findings
# across the codebase and we're prioritising other work. Revisit later.
Checks: 'clang-diagnostic-*,clang-analyzer-*,bugprone-*,performance-*,-modernize-*,-readability-*,-cppcoreguidelines-*,-bugprone-easily-swappable-parameters'
