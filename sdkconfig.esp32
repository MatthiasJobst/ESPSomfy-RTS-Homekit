# sdkconfig.esp32 — overlay for classic ESP32 (4 MB flash).
# Applied after sdkconfig.defaults (which targets ESP32-S3 with 8 MB flash):
#   idf.py set-target esp32
#   idf.py -DSDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.esp32;sdkconfig.release" build

# Flash size — 4 MB (overrides sdkconfig.defaults CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Partition table for 4 MB flash:
#   two 1.5 MB OTA slots, 921 KB spiffs, HAP partitions pinned at top of flash.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

# Boya flash chip support — suppresses "using generic driver" warning on BY25Q32 etc.
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
